// timezone.grav — time zones without the C library's process-wide TZ: the
// system's zone files (/usr/share/zoneinfo, RFC 8536) read once and kept, with
// the POSIX rule at their end for the years past their table, fixed offsets,
// and the calendar arithmetic (days <-> dates) that Moment builds on.
//
//   let nairobi = TimeZone.of("Africa/Nairobi")
//   nairobi.offsetAt(Time.now())          // 10800
//   TimeZone.of("+05:30").name            // "+05:30"
//   TimeZone.local()                      // the system's zone (TZ, /etc/timezone, /etc/localtime)
import "std"

namespace apogee {

    // Days and dates in the proleptic Gregorian calendar (H. Hinnant's algorithms):
    // no tables, no C library, any year.
    class Civil {
        // Days since 1970-01-01 of a date (month 1..12).
        static fn days(year: long, month: int, day: int) -> long {
            let y = month <= 2 ? year - 1 : year;
            let era = (y >= 0 ? y : y - 399) / 400;
            let yoe = y - era * 400;
            let m = month as long;
            let doy = (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + (day as long) - 1;
            let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
            return era * 146097 + doe - 719468;
        }
        // The date of a day number: [year, month, day].
        static fn date(dayNumber: long) -> Array<long> {
            let z = dayNumber + 719468;
            let era = (z >= 0 ? z : z - 146096) / 146097;
            let doe = z - era * 146097;
            let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
            let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
            let mp = (5 * doy + 2) / 153;
            let d = doy - (153 * mp + 2) / 5 + 1;
            let m = mp < 10 ? mp + 3 : mp - 9;
            let y = yoe + era * 400 + (m <= 2 ? 1 : 0);
            return [y, m, d];
        }
        // 0 = Sunday … 6 = Saturday.
        static fn weekday(dayNumber: long) -> int {
            let w = (dayNumber + 4) % 7;
            return (w < 0 ? w + 7 : w) as int;
        }
        static fn isLeap(year: long) -> bool { return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0; }
        static fn daysInMonth(year: long, month: int) -> int {
            if (month == 2) { return Civil.isLeap(year) ? 29 : 28; }
            return month == 4 || month == 6 || month == 9 || month == 11 ? 30 : 31;
        }
        // Floor division and modulo (the calendar needs them for times before 1970).
        static fn floorDiv(a: long, b: long) -> long { let q = a / b; return (a % b != 0 && ((a < 0) != (b < 0))) ? q - 1 : q; }
        static fn floorMod(a: long, b: long) -> long { return a - Civil.floorDiv(a, b) * b; }
    }

    // A POSIX TZ rule ("EST5EDT,M3.2.0,M11.1.0", "<+03>-3"): what a zone file
    // says holds after its last listed transition.
    class TzRule {
        public stdName: string = ""
        public dstName: string = ""
        // Seconds east of UTC (POSIX writes them west, inverted here).
        public stdOffset: int = 0
        public dstOffset: int = 0
        public hasDst: bool = false
        // Start and end: kind (0 = Jn, 1 = n, 2 = Mm.w.d), the numbers, and the local time of day.
        private startKind: int = 0
        private startA: int = 0
        private startB: int = 0
        private startC: int = 0
        private startTime: int = 7200
        private endKind: int = 0
        private endA: int = 0
        private endB: int = 0
        private endC: int = 0
        private endTime: int = 7200
        private text: string
        private pos: int = 0

        constructor(text: string) { self.text = text; }

        // The rule, or null when the text is not one.
        static fn parse(text: string) -> TzRule {
            let r = new TzRule(text);
            return r.read() ? r : null;
        }
        private fn read() -> bool {
            self.stdName = self.readName();
            if (self.stdName == "") { return false; }
            let off = self.readOffset();
            if (off == -999999) { return false; }
            self.stdOffset = -off;
            if (self.pos >= self.text.length) { return true; }
            self.dstName = self.readName();
            if (self.dstName == "") { return false; }
            self.hasDst = true;
            self.dstOffset = self.stdOffset + 3600;
            if (self.pos < self.text.length && self.text[self.pos] as int != 44) {
                let d = self.readOffset();
                if (d == -999999) { return false; }
                self.dstOffset = -d;
            }
            if (self.pos >= self.text.length) {
                // (no dates given: the US rules, as POSIX says)
                self.startKind = 2; self.startA = 3; self.startB = 2; self.startC = 0;
                self.endKind = 2; self.endA = 11; self.endB = 1; self.endC = 0;
                return true;
            }
            if (self.text[self.pos] as int != 44) { return false; }
            self.pos += 1;
            let s = self.readDate();
            if (s.size() == 0) { return false; }
            self.startKind = s[0]; self.startA = s[1]; self.startB = s[2]; self.startC = s[3]; self.startTime = s[4];
            if (self.pos >= self.text.length || self.text[self.pos] as int != 44) { return false; }
            self.pos += 1;
            let e = self.readDate();
            if (e.size() == 0) { return false; }
            self.endKind = e[0]; self.endA = e[1]; self.endB = e[2]; self.endC = e[3]; self.endTime = e[4];
            return self.pos == self.text.length;
        }
        private fn readName() -> string {
            let t = self.text;
            if (self.pos < t.length && t[self.pos] as int == 60) {          // <+03>
                let close = Str.indexFrom(t, ">", self.pos);
                if (close < 0) { return ""; }
                let n = t[self.pos + 1..close];
                self.pos = close + 1;
                return n;
            }
            let start = self.pos;
            while (self.pos < t.length) {
                let c = t[self.pos] as int;
                if (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122))) { break; }
                self.pos += 1;
            }
            return self.pos - start >= 3 ? t[start..self.pos] : "";
        }
        // [+-]hh[:mm[:ss]] in seconds, -999999 when malformed.
        private fn readOffset() -> int {
            let t = self.text;
            let sign = 1;
            if (self.pos < t.length && (t[self.pos] as int == 43 || t[self.pos] as int == 45)) {
                if (t[self.pos] as int == 45) { sign = -1; }
                self.pos += 1;
            }
            let total = 0;
            let mult = 3600;
            for (part in 0..3) {
                let start = self.pos;
                let v = 0;
                while (self.pos < t.length && t[self.pos] as int >= 48 && t[self.pos] as int <= 57) { v = v * 10 + (t[self.pos] as int - 48); self.pos += 1; }
                if (self.pos == start) { return part == 0 ? -999999 : total * sign; }
                total += v * mult;
                mult = mult / 60;
                if (part < 2 && self.pos < t.length && t[self.pos] as int == 58) { self.pos += 1; } else { break; }
            }
            return total * sign;
        }
        private fn readNumber() -> int {
            let v = 0;
            let start = self.pos;
            while (self.pos < self.text.length && self.text[self.pos] as int >= 48 && self.text[self.pos] as int <= 57) { v = v * 10 + (self.text[self.pos] as int - 48); self.pos += 1; }
            return self.pos == start ? -1 : v;
        }
        // [kind, a, b, c, time]; empty when malformed.
        private fn readDate() -> Array<int> {
            let t = self.text;
            let out = new Array<int>();
            if (self.pos >= t.length) { return out; }
            let c = t[self.pos] as int;
            if (c == 77) {                                                    // Mm.w.d
                self.pos += 1;
                let m = self.readNumber();
                if (m < 1 || self.pos >= t.length || t[self.pos] as int != 46) { return out; }
                self.pos += 1;
                let w = self.readNumber();
                if (w < 1 || self.pos >= t.length || t[self.pos] as int != 46) { return out; }
                self.pos += 1;
                let d = self.readNumber();
                if (d < 0) { return out; }
                out.push(2); out.push(m); out.push(w); out.push(d);
            } else if (c == 74) {                                             // Jn
                self.pos += 1;
                let n = self.readNumber();
                if (n < 1) { return out; }
                out.push(0); out.push(n); out.push(0); out.push(0);
            } else {
                let n = self.readNumber();
                if (n < 0) { return out; }
                out.push(1); out.push(n); out.push(0); out.push(0);
            }
            let time = 7200;
            if (self.pos < t.length && t[self.pos] as int == 47) {
                self.pos += 1;
                time = self.readOffset();
                if (time == -999999) { return new Array<int>(); }
            }
            out.push(time);
            return out;
        }

        // The day number of a rule date in `year`.
        private static fn ruleDay(year: long, kind: int, a: int, b: int, c: int) -> long {
            if (kind == 0) {
                let n = a as long - 1;
                if (Civil.isLeap(year) && a >= 60) { n += 1; }
                return Civil.days(year, 1, 1) + n;
            }
            if (kind == 1) { return Civil.days(year, 1, 1) + (a as long); }
            let first = Civil.days(year, a, 1);
            let dow = Civil.weekday(first);
            let day = 1 + ((c - dow + 7) % 7) + (b - 1) * 7;
            let dim = Civil.daysInMonth(year, a);
            while (day > dim) { day -= 7; }
            return first + (day as long) - 1;
        }
        // When DST starts and ends in `year`, as unix seconds.
        fn startOf(year: long) -> long { return TzRule.ruleDay(year, self.startKind, self.startA, self.startB, self.startC) * 86400 + (self.startTime as long) - (self.stdOffset as long); }
        fn endOf(year: long) -> long { return TzRule.ruleDay(year, self.endKind, self.endA, self.endB, self.endC) * 86400 + (self.endTime as long) - (self.dstOffset as long); }
        fn isDstAt(t: long) -> bool {
            if (!self.hasDst) { return false; }
            let year = Civil.date(Civil.floorDiv(t + (self.stdOffset as long), 86400))[0];
            let s = self.startOf(year);
            let e = self.endOf(year);
            return s < e ? (t >= s && t < e) : !(t >= e && t < s);
        }
        fn offsetAt(t: long) -> int { return self.isDstAt(t) ? self.dstOffset : self.stdOffset; }
        fn abbreviationAt(t: long) -> string { return self.isDstAt(t) ? self.dstName : self.stdName; }
    }

    // A time zone: a name, and the offset from UTC at any moment.
    class TimeZone {
        public name: string
        // Fixed zones: the offset; zone files: their transitions and types.
        private fixed: bool = true
        private fixedOffset: int = 0
        private fixedAbbr: string = ""
        private times: Array<long>
        private typeOf: Array<int>
        private offsets: Array<int>
        private dst: Array<bool>
        private abbrs: Array<string>
        private rule: TzRule = null

        static zones: HashMap<string, TimeZone> = new HashMap<string, TimeZone>()
        static zonesLock: Mutex = new Mutex()
        static localZone: TimeZone = null
        // Where zone files are (the ZONEINFO variable overrides it).
        static directory: string = "/usr/share/zoneinfo"

        constructor(name: string) {
            self.name = name;
            self.times = new Array<long>();
            self.typeOf = new Array<int>();
            self.offsets = new Array<int>();
            self.dst = new Array<bool>();
            self.abbrs = new Array<string>();
        }

        static fn utc() -> TimeZone { return TimeZone.of("UTC"); }
        // A zone by name: "UTC", "Africa/Nairobi", "+03:00", "-0500", "Z";
        // ValueError for one the system does not have. Loaded once, then shared.
        static fn of(name: string) -> TimeZone {
            TimeZone.zonesLock.lock();
            let z = TimeZone.zones.getOr(name, null);
            TimeZone.zonesLock.unlock();
            if (z != null) { return z; }
            z = TimeZone.load(name);
            TimeZone.zonesLock.lock();
            let had = TimeZone.zones.getOr(name, null);
            if (had != null) { z = had; } else { TimeZone.zones.put(name, z); }
            TimeZone.zonesLock.unlock();
            return z;
        }
        // As of(), but null for an unknown zone.
        static fn tryOf(name: string) -> TimeZone {
            try { return TimeZone.of(name); } catch (e: ValueError) { return null; }
        }
        // A zone `seconds` east of UTC, named like "+03:00".
        static fn fixedAt(seconds: int) -> TimeZone { return TimeZone.of(TimeZone.offsetText(seconds, true)); }
        // The system's zone: TZ, else /etc/timezone, else where /etc/localtime
        // links to, else that file itself (named "Local").
        static fn local() -> TimeZone {
            if (TimeZone.localZone != null) { return TimeZone.localZone; }
            let name = Str.trim(OS.getEnvOr("TZ", ""));
            if (Str.startsWith(name, ":")) { name = name[1..]; }
            if (name == "" && new File("/etc/timezone").exists()) { name = Str.trim(new File("/etc/timezone").read()); }
            if (name == "") {
                // (/etc/localtime is usually a link into the zone directory: its name is the rest of the path)
                let real = Path.realPath("/etc/localtime");
                let at = Str.indexOf(real, "/zoneinfo/");
                if (at >= 0) { name = real[at + 10..]; }
            }
            let z: TimeZone = null;
            if (name != "") { z = TimeZone.tryOf(name); }
            if (z == null && new File("/etc/localtime").exists()) {
                z = TimeZone.fromFile("Local", "/etc/localtime");
            }
            if (z == null) { z = TimeZone.utc(); }
            TimeZone.localZone = z;
            return z;
        }
        // Every zone name the system has (from its zone1970.tab / zone.tab), sorted.
        static fn names() -> Array<string> {
            let out = new Array<string>();
            let dir = TimeZone.dir();
            let tab = new File(dir + "/tzdata.zi").exists() ? "" : (new File(dir + "/zone1970.tab").exists() ? dir + "/zone1970.tab" : dir + "/zone.tab");
            if (tab == "") {
                for (line in Str.lines(new File(dir + "/tzdata.zi").read())) {
                    if (Str.startsWith(line, "Z ")) { out.push(Str.split(line, " ")[1]); }
                    else if (Str.startsWith(line, "L ")) { out.push(Str.split(line, " ")[2]); }
                }
            } else if (new File(tab).exists()) {
                for (line in Str.lines(new File(tab).read())) {
                    if (line == "" || Str.startsWith(line, "#")) { continue; }
                    let cols = Str.split(line, "\t");
                    if (cols.size() >= 3) { out.push(cols[2]); }
                }
            }
            out.push("UTC");
            Sort.sort(out);
            let unique = new Array<string>();
            for (n in out) { if (unique.size() == 0 || unique[unique.size() - 1] != n) { unique.push(n); } }
            return unique;
        }
        private static fn dir() -> string { let d = OS.getEnvOr("ZONEINFO", ""); return d == "" ? TimeZone.directory : d; }

        private static fn load(name: string) -> TimeZone {
            let up = Str.upper(name);
            if (up == "UTC" || up == "Z" || up == "GMT" || up == "ETC/UTC" || up == "UCT" || up == "ZULU") {
                let z = new TimeZone(up == "Z" ? "UTC" : (up == "GMT" ? "GMT" : "UTC"));
                z.fixedAbbr = z.name;
                return z;
            }
            let off = TimeZone.parseOffset(name);
            if (off != -999999) {
                let z = new TimeZone(TimeZone.offsetText(off, true));
                z.fixedOffset = off;
                z.fixedAbbr = z.name;
                return z;
            }
            if (name == "" || Str.contains(name, "..") || Str.startsWith(name, "/")) { throw new ValueError("not a time zone: '" + name + "'"); }
            let path = TimeZone.dir() + "/" + name;
            if (!new File(path).exists()) { throw new ValueError("unknown time zone '" + name + "'"); }
            let z = TimeZone.fromFile(name, path);
            if (z == null) { throw new ValueError("'" + path + "' is not a zone file"); }
            return z;
        }
        // "+03:00", "-0530", "+3": seconds east, -999999 when it is not an offset.
        static fn parseOffset(text: string) -> int {
            let t = Str.trim(text);
            if (Str.startsWith(Str.upper(t), "UTC") || Str.startsWith(Str.upper(t), "GMT")) { t = t[3..]; }
            if (t.length < 2) { return -999999; }
            let c = t[0] as int;
            if (c != 43 && c != 45) { return -999999; }
            let digits = Str.replace(t[1..], ":", "");
            if (!Str.isDigits(digits) || digits.length > 4) { return -999999; }
            let h = 0;
            let m = 0;
            if (digits.length <= 2) { h = Integer.parseOr(digits, 0) as int; }
            else { h = Integer.parseOr(digits[..digits.length - 2], 0) as int; m = Integer.parseOr(digits[digits.length - 2..], 0) as int; }
            if (h > 18 || m > 59) { return -999999; }
            let secs = h * 3600 + m * 60;
            return c == 45 ? -secs : secs;
        }
        // "+03:00" (or "+0300" without the colon).
        static fn offsetText(seconds: int, colon: bool = true) -> string {
            let sign = seconds < 0 ? "-" : "+";
            let a = seconds < 0 ? -seconds : seconds;
            let h = a / 3600;
            let m = (a % 3600) / 60;
            let hh = h < 10 ? "0${h}" : "${h}";
            let mm = m < 10 ? "0${m}" : "${m}";
            return sign + hh + (colon ? ":" : "") + mm;
        }

        // Reads a TZif file (versions 1-4), null when it is not one.
        static fn fromFile(name: string, path: string) -> TimeZone {
            let b = Bytes.fromBinary(new File(path).readBinary());
            if (b.size() < 44 || b.readUint(0, 4) != 1415211366) { return null; }
            let version = b.get(4);
            let z = new TimeZone(name);
            z.fixed = false;
            let at = 0;
            let wide = false;
            if (version >= 50) {
                // (skip the 32-bit block: the 64-bit one after it says everything)
                at = 44 + TimeZone.blockSize(b, 0, false);
                if (b.size() < at + 44 || b.readUint(at, 4) != 1415211366) { return null; }
                wide = true;
            }
            let isut = b.readUint(at + 20, 4) as int;
            let isstd = b.readUint(at + 24, 4) as int;
            let leap = b.readUint(at + 28, 4) as int;
            let timecnt = b.readUint(at + 32, 4) as int;
            let typecnt = b.readUint(at + 36, 4) as int;
            let charcnt = b.readUint(at + 40, 4) as int;
            let p = at + 44;
            let tw = wide ? 8 : 4;
            for (i in 0..timecnt) {
                let v = b.readUint(p + i * tw, tw);
                if (!wide && v >= 2147483648) { v -= 4294967296; }
                z.times.push(v);
            }
            p += timecnt * tw;
            for (i in 0..timecnt) { z.typeOf.push(b.get(p + i)); }
            p += timecnt;
            let abbrIndex = new Array<int>();
            for (i in 0..typecnt) {
                let o = b.readUint(p + i * 6, 4);
                if (o >= 2147483648) { o -= 4294967296; }
                z.offsets.push(o as int);
                z.dst.push(b.get(p + i * 6 + 4) != 0);
                abbrIndex.push(b.get(p + i * 6 + 5));
            }
            p += typecnt * 6;
            // (NUL-separated, so read from the bytes: a string ends at the first NUL)
            for (ix in abbrIndex) {
                let end = ix;
                while (end < charcnt && b.get(p + end) != 0) { end += 1; }
                z.abbrs.push(ix < charcnt ? b.slice(p + ix, p + end).toString() : "");
            }
            p += charcnt + leap * (tw + 4) + isstd + isut;
            if (wide && p < b.size() && b.get(p) == 10) {
                let end = p + 1;
                while (end < b.size() && b.get(end) != 10) { end += 1; }
                let footer = b.slice(p + 1, end).toString();
                if (footer != "") { z.rule = TzRule.parse(footer); }
            }
            if (z.offsets.size() == 0) { return null; }
            return z;
        }
        private static fn blockSize(b: Bytes, at: int, wide: bool) -> int {
            let tw = wide ? 8 : 4;
            let isut = b.readUint(at + 20, 4) as int;
            let isstd = b.readUint(at + 24, 4) as int;
            let leap = b.readUint(at + 28, 4) as int;
            let timecnt = b.readUint(at + 32, 4) as int;
            let typecnt = b.readUint(at + 36, 4) as int;
            let charcnt = b.readUint(at + 40, 4) as int;
            return timecnt * tw + timecnt + typecnt * 6 + charcnt + leap * (tw + 4) + isstd + isut;
        }

        // The type in force at `t` (-1: the rule decides).
        private fn typeAt(t: long) -> int {
            // (the arrays read into locals once: indexing a field costs a retain each time)
            let times = self.times;
            let n = times.size();
            if (n == 0 || t < times[0]) {
                if (n == 0 && self.rule != null) { return -1; }
                let dst = self.dst;
                for (i in 0..dst.size()) { if (!dst[i]) { return i; } }
                return 0;
            }
            if (t >= times[n - 1]) { return self.rule != null ? -1 : self.typeOf[n - 1]; }
            let lo = 0;
            let hi = n - 1;
            while (lo < hi) {                                   // the last transition <= t
                let mid = (lo + hi + 1) / 2;
                if (times[mid] <= t) { lo = mid; } else { hi = mid - 1; }
            }
            return self.typeOf[lo];
        }
        // Seconds east of UTC at the moment `t` (unix seconds).
        fn offsetAt(t: long) -> int {
            if (self.fixed) { return self.fixedOffset; }
            let k = self.typeAt(t);
            return k < 0 ? self.rule.offsetAt(t) : self.offsets[k];
        }
        // "EAT", "EDT", "+0545": the abbreviation in use at `t`.
        fn abbreviationAt(t: long) -> string {
            if (self.fixed) { return self.fixedAbbr; }
            let k = self.typeAt(t);
            return k < 0 ? self.rule.abbreviationAt(t) : self.abbrs[k];
        }
        // Whether daylight saving time is in force at `t`.
        fn isDstAt(t: long) -> bool {
            if (self.fixed) { return false; }
            let k = self.typeAt(t);
            return k < 0 ? self.rule.isDstAt(t) : self.dst[k];
        }
        // The moment a wall-clock time (as seconds, counted as if it were UTC)
        // happens here. In a gap (the clocks jumped forward) it moves past the
        // gap, as PHP does; a time that happens twice is the first.
        fn toUnix(local: long) -> long {
            if (self.fixed) { return local - (self.fixedOffset as long); }
            let before = self.offsetAt(local - 86400) as long;
            let after = self.offsetAt(local + 86400) as long;
            if (before == after) {
                let guess = local - before;
                let o = self.offsetAt(guess) as long;
                return o == before ? guess : local - o;
            }
            let a = local - before;
            let b = local - after;
            let aValid = self.offsetAt(a) as long == before;
            let bValid = self.offsetAt(b) as long == after;
            if (aValid && bValid) { return a < b ? a : b; }
            if (aValid) { return a; }
            if (bValid) { return b; }
            return a;
        }
        // Whether the zone never changes its offset.
        fn isFixed() -> bool { return self.fixed || (self.offsets.size() == 1 && self.rule == null); }
        // The transitions between `from` and `to` (unix seconds), as [time, offset after] pairs.
        fn transitions(from: long, to: long) -> Array<Array<long>> {
            let out = new Array<Array<long>>();
            if (self.fixed) { return out; }
            for (i in 0..self.times.size()) {
                let t = self.times[i];
                if (t >= from && t <= to) { out.push([t, self.offsets[self.typeOf[i]] as long]); }
            }
            if (self.rule != null && self.rule.hasDst) {
                let last = self.times.size() > 0 ? self.times[self.times.size() - 1] : from - 1;
                let y0 = Civil.date(Civil.floorDiv((from > last ? from : last), 86400))[0];
                let y1 = Civil.date(Civil.floorDiv(to, 86400))[0];
                for (y in y0..=y1) {
                    let s = self.rule.startOf(y);
                    let e = self.rule.endOf(y);
                    let pair = s < e ? [s, e] : [e, s];
                    for (t in pair) {
                        if (t > last && t >= from && t <= to) { out.push([t, self.rule.offsetAt(t) as long]); }
                    }
                }
            }
            return out;
        }
        fn operator==(o: TimeZone) -> bool { return o != null && self.name == o.name; }
        fn toString() -> string { return self.name; }
    }
}
